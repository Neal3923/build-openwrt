diff --git a/luci-app-netwizard/root/etc/uci-defaults/40-luci-netwizard b/luci-app-netwizard/root/etc/uci-defaults/40-luci-netwizard
index d037c82..9013682 100644
--- a/luci-app-netwizard/root/etc/uci-defaults/40-luci-netwizard
+++ b/luci-app-netwizard/root/etc/uci-defaults/40-luci-netwizard
@@ -1,4 +1,28 @@
 #!/bin/sh
+
+# Migrate configurations created by older NetWizard releases. Keep the named
+# firewall.docker section owned by dockerd and remove anonymous duplicates.
+remove_legacy_docker_zone() {
+    local section="$1"
+    local zone_name
+
+    config_get zone_name "$section" name
+    [ "$zone_name" = "docker" ] || return 0
+    case "$section" in
+        cfg*) uci -q delete "firewall.$section" ;;
+    esac
+}
+
+if [ -f /etc/config/firewall ]; then
+    . /lib/functions.sh
+    config_load firewall
+    config_foreach remove_legacy_docker_zone zone
+    uci -q delete firewall.docker_to_wan
+    uci -q delete firewall.docker_to_lan
+    uci -q delete firewall.lan_to_docker
+    uci -q commit firewall
+fi
+
 [ ! -f "/usr/share/ucitrack/luci-app-netwizard.json" ] && {
     cat > /usr/share/ucitrack/luci-app-netwizard.json << EEOF
 {
